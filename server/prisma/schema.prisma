datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Hall {
  id           String    @id @default(uuid())
  grade        Int       @unique // Grade 1 to 5
  name         String
  subtitle     String
  capacityMin  Int
  capacityMax  Int
  basePrice    Float
  image        String
  features     String    // Stored as JSON string
  description  String
  bookings     Booking[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Package {
  id          String    @id @default(uuid())
  tier        String    @unique // Classic, Silver, Gold
  name        String
  price       Float
  badge       String?
  features    String    // Stored as JSON string
  description String
  bookings    Booking[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Addon {
  id          String         @id @default(uuid())
  category    String
  name        String
  price       Float
  unit        String         // per event, per guest, per hour
  description String
  bookings    BookingAddon[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Booking {
  id            String         @id @default(uuid())
  reference     String         @unique
  customerName  String
  customerEmail String
  customerPhone String
  eventType     String
  guestCount    Int
  eventDate     DateTime
  hallId        String
  hall          Hall           @relation(fields: [hallId], references: [id])
  packageId     String
  package       Package        @relation(fields: [packageId], references: [id])
  addons        BookingAddon[]
  totalAmount   Float
  depositAmount Float          // 50% required deposit
  balanceAmount Float          // 50% remaining due 14 days prior
  status        String         @default("PENDING") // PENDING, DEPOSIT_PAID, FULLY_PAID, CANCELLED
  paystackRef   String?
  notes         String?
  payments      Payment[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model BookingAddon {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addonId   String
  addon     Addon    @relation(fields: [addonId], references: [id])
  price     Float
}

model Payment {
  id          String   @id @default(uuid())
  reference   String   @unique
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount      Float
  gateway     String   @default("PAYSTACK")
  status      String   // SUCCESS, FAILED, PENDING
  channel     String?  // card, bank_transfer, ussd
  paystackRef String?
  createdAt   DateTime @default(now())
}

model Admin {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String   // Hashed password
  name      String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
